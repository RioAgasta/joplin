<!doctype html>
<html lang="en">
<head>
	<title>{{pageTitle}}</title>
	<meta charset="utf-8">
  <meta name="description" content="Joplin Server.">
	{{> favicons}}
  <link rel="preload" href="{{{global.baseUrl}}}/css/main.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{{global.baseUrl}}}/css/main.css"></noscript>
	{{#cssFiles}}
		<link rel="stylesheet" href="{{{.}}}" crossorigin="anonymous">
	{{/cssFiles}}
	{{#jsFiles}}
		<script src="{{{.}}}"></script>
	{{/jsFiles}}
</head>
	<body class="page-{{{pageName}}}">
		<main class="main">
			<div class="container">
				{{{contentHtml}}}
			</div>
		</main>
		{{> footer}}
	</body>
</html>
